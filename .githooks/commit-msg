#!/usr/bin/env bash
# commit-msg hook — validate commit message against COMMIT_FORMAT.md.
#
# Rules (see COMMIT_FORMAT.md):
#   1. Subject (line 1): `<type>(<scope>)?: <subject>` shape; type in
#      {feat, fix, refactor, test, docs, build, chore}; max 72 bytes;
#      no trailing period.
#   2. Line 2: blank (separator between subject and body).
#   3. Body lines: max 72 bytes each; no multi-line bullet wrap
#      (one bullet = one line). Body is `- ` bullets ONLY — no prose
#      lead paragraph, no blank line between bullets (contiguous) —
#      and at most 3 bullets (COMMIT_FORMAT.md sec 3: "Bullet points
#      only", "contiguous", "1-3 items, fewer is better").
#   4. Style: English only (ASCII U+0020-U+007E plus the small
#      typographic whitelist §, –, —, •, …, →); no `Co-Authored-By`;
#      no `Generated with Claude Code`; no emoji (Unicode pictograph
#      ranges U+1F300-U+1FAFF and U+1F1E6-U+1F1FF).
#
# Install (one-time per clone):
#   git config core.hooksPath .githooks
#
# Gated by `crates/mnemosyne-cli/tests/git_hooks_smoke.rs` (R899): each rule
# above has a message that must be accepted and one that must be rejected
# for the stated reason, run against THIS file. Add a case with any rule.

set -euo pipefail

msg_file="$1"

# THE TWO CONTENT RULES BELOW ARE THE ONLY THING HERE THAT READS THE MACHINE.
# Both are `grep -P` over Unicode code-point classes, and both used to end in
# `2>/dev/null`, which turns every way that can go wrong into the same answer as
# "no match" — a rule reporting clean without having run.
#
# IT WENT WRONG, and not in the way the first repair guessed. `git_hooks_smoke`
# passes on this machine and on one build host, and on the other it said
# `commit-msg must REJECT an emoji, but it accepted`. The obvious reading is that
# the second host's grep has no `-P`; the measurement says otherwise — it has
# one. What it does not have is a UTF-8 LOCALE, and `grep -P` only interprets its
# input as characters when the locale says to. Under `LC_ALL=C` every byte of a
# four-byte emoji is its own character and no code-point class can match it, so
# the emoji rule and the English-only rule were both silently off there.
#
# So what is probed is THE CAPABILITY, not the flag: an actual emoji through the
# actual expression. A flag probe would have passed on the very host that was
# broken. If the ambient locale cannot do it, one that can is asked for
# explicitly, because repairing beats refusing; and only if neither works does
# this refuse — loudly, because a hook that cannot enforce what it claims must
# not look like one that found nothing.
pcre_locale=()
utf8_capable() {
    printf '\360\237\230\200\n' | "$@" grep -qP '[\x{1F300}-\x{1FAFF}]'
}
if utf8_capable; then
    :
elif utf8_capable env LC_ALL=C.UTF-8; then
    pcre_locale=(env LC_ALL=C.UTF-8)
else
    echo "commit-msg: this machine's grep cannot match a Unicode code-point" >&2
    echo "  class — no -P (PCRE) support, or no UTF-8 locale for it to work" >&2
    echo "  in — so the emoji rule and the English-only rule cannot run at" >&2
    echo "  all. Refusing rather than passing: a rule that could not run must" >&2
    echo "  not look like a rule that held. Install GNU grep and a UTF-8" >&2
    echo "  locale (C.UTF-8 is enough), or commit from a machine that has" >&2
    echo "  them." >&2
    exit 1
fi

# Skip merge commits — git writes their subject and user did not author it.
first_line=$(head -n 1 "$msg_file")
if [[ "$first_line" =~ ^Merge ]]; then
    exit 0
fi

# Strip leading '#'-comment lines (git appends instructions during
# interactive commit; they are stripped before commit lands, so the hook
# should not see them as content).
mapfile -t lines < <(grep -v '^#' "$msg_file")

errors=()

# Last non-empty line index — trim trailing blank lines.
last_nonempty=-1
for ((i=${#lines[@]}-1; i>=0; i--)); do
    if [[ -n "${lines[i]}" ]]; then
        last_nonempty=$i
        break
    fi
done

if [[ "$last_nonempty" -lt 0 ]]; then
    echo "commit-msg: empty message" >&2
    exit 1
fi

# --- Rule 1: Subject line (line 1) ---
subject="${lines[0]:-}"
subject_bytes=$(printf '%s' "$subject" | wc -c)

if ! [[ "$subject" =~ ^(feat|fix|refactor|test|docs|build|chore)(\([a-zA-Z0-9_/-]+\))?:\ .+$ ]]; then
    errors+=("Line 1: subject must match '<type>(<scope>)?: <subject>' with type in {feat,fix,refactor,test,docs,build,chore}")
fi

if [[ "$subject_bytes" -gt 72 ]]; then
    errors+=("Line 1: $subject_bytes bytes (max 72)")
fi

if [[ "$subject" =~ \.$ ]]; then
    errors+=("Line 1: subject must not end with a period")
fi

# --- Rule 2: Line 2 must be blank (when body is present) ---
if [[ "$last_nonempty" -ge 1 && -n "${lines[1]:-}" ]]; then
    errors+=("Line 2: must be blank (separator between subject and body)")
fi

# --- Rule 3: Body lines (lines 3+) ---
# Body is `- ` bullets only — no prose lead paragraph, no blank line
# between bullets (contiguous) — and at most 3 (COMMIT_FORMAT.md sec 3).
prev_was_bullet=0
bullet_count=0
for ((i=2; i<=last_nonempty; i++)); do
    line="${lines[i]:-}"
    line_num=$((i+1))

    # No blank / whitespace-only line inside the body — the bullets must
    # be contiguous (a blank "enter" between bullets is rejected).
    # COMMIT_FORMAT.md sec 3.
    if [[ "$line" =~ ^[[:space:]]*$ ]]; then
        errors+=("Line $line_num: blank line inside body — bullets must be contiguous, no blank separators (COMMIT_FORMAT.md sec 3)")
        prev_was_bullet=0
        continue
    fi

    line_bytes=$(printf '%s' "$line" | wc -c)

    # Length check
    if [[ "$line_bytes" -gt 72 ]]; then
        errors+=("Line $line_num: $line_bytes bytes (max 72)")
    fi

    # Bullet-only: every non-empty body line must start with '- '. The
    # indented-continuation case (a wrapped bullet) gets a more specific
    # message; any other non-bullet line is a prose paragraph.
    if [[ "$line" =~ ^-\  ]]; then
        prev_was_bullet=1
        bullet_count=$((bullet_count + 1))
    else
        if [[ "$prev_was_bullet" -eq 1 && "$line" =~ ^[[:space:]]+[^[:space:]] ]]; then
            errors+=("Line $line_num: indented continuation of previous bullet — one bullet = one line")
        else
            errors+=("Line $line_num: body must be '- ' bullets only, no prose (COMMIT_FORMAT.md sec 3)")
        fi
        prev_was_bullet=0
    fi
done

# At most 3 bullets — condense to the key changes (COMMIT_FORMAT.md sec 3).
if [[ "$bullet_count" -gt 3 ]]; then
    errors+=("Body has $bullet_count bullets (max 3) — condense to 1-3 key changes (COMMIT_FORMAT.md sec 3)")
fi

# --- Rule 4: Forbidden style markers (whole message) ---
if grep -q -E 'Co-Authored-By|Co-authored-by' "$msg_file"; then
    errors+=("Forbidden tag: 'Co-Authored-By' (COMMIT_FORMAT.md sec 4)")
fi
if grep -q -E 'Generated with Claude Code|Generated by Claude Code|Generated with \[Claude' "$msg_file"; then
    errors+=("Forbidden tag: 'Generated with Claude Code' (COMMIT_FORMAT.md sec 4)")
fi

# Emoji detection — Unicode pictograph / regional-indicator ranges.
# Typographic symbols (§ U+00A7, → U+2192, – U+2013, • U+2022, etc.) are
# below the U+1F300 cutoff so they are not flagged.
if ${pcre_locale[@]+"${pcre_locale[@]}"} \
    grep -qP '[\x{1F300}-\x{1FAFF}\x{1F1E6}-\x{1F1FF}]' "$msg_file"; then
    errors+=("Emoji detected (COMMIT_FORMAT.md sec 4: no emojis)")
fi

# English-only check — whitelist ASCII printable (U+0020-U+007E) + tab
# (U+0009) + LF (U+000A) + CR (U+000D) plus the small typographic symbol
# set the commit log is allowed to carry (§ U+00A7, en-dash U+2013, em-dash
# U+2014, bullet U+2022, ellipsis U+2026, rightwards arrow U+2192).
# Anything else (Hangul, Kana, CJK ideographs, Cyrillic, Greek, etc.) is
# rejected — project narrative needing Korean lives in claudedocs/ or
# memory/, not in commit messages.
if non_english_lines=$(${pcre_locale[@]+"${pcre_locale[@]}"} \
    grep -nP '[^\x{0009}\x{000A}\x{000D}\x{0020}-\x{007E}\x{00A7}\x{2013}\x{2014}\x{2022}\x{2026}\x{2192}]' "$msg_file"); then
    if [[ -n "$non_english_lines" ]]; then
        errors+=("Non-English / non-whitelisted character (COMMIT_FORMAT.md sec 4: English only)")
        # Surface the first few offending lines so the author can locate
        # the exact characters without re-reading the message.
        while IFS= read -r offender; do
            errors+=("  $offender")
        done <<< "$(printf '%s\n' "$non_english_lines" | head -n 5)"
    fi
fi

if [[ "${#errors[@]}" -gt 0 ]]; then
    {
        echo "[mnemosyne commit-msg] COMMIT_FORMAT.md violations:"
        for err in "${errors[@]}"; do
            echo "  - $err"
        done
        echo ""
        echo "See COMMIT_FORMAT.md for the full rule set."
        echo "Bypass: --no-verify (discouraged)."
    } >&2
    exit 1
fi

exit 0
