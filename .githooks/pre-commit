#!/usr/bin/env bash
# Mnemosyne self-application pre-commit gate — runs on every `git commit`.
#
# Mnemosyne dogfoods its own validator against the repo's atomic store
# (the SSOT) + code citation defense before every commit. Plus a clippy
# gate when `.rs` files are staged (workspace lint baseline).
#
# Gates:
#
#   2. Code citation defense — `mnemosyne-cli validate-code-refs`
#      always runs; subcommand silently skips when
#      `[plugins.set_equality_validator]` is unconfigured (5-min setup
#      promise). Otherwise scans `paths` for `<entry_id_prefix><digits>`
#      and `§<id>` citations and rejects on hallucination / unbound /
#      decay / inventory / symbol-mismatch violations (severity per config).
#
#   3. Workspace gate — `mnemosyne-cli validate-workspace` when the atomic
#      sidecar (`docs/.atomic/workspace.atomic.json`, the SSOT) is staged.
#      Store-direct: T1 prose-orphan delta, T2 frozen-ledger, T3/T4 style,
#      publishable/audit divergence, ledger match, commit↔ledger drift.
#
#   4. Format gate — `cargo fmt --all --check` when any `.rs` file is
#      staged. rustfmt 4-space repo-wide (rustfmt.toml, edition 2021);
#      rejects unformatted code so layout stays uniform.
#
#   5. Clippy gate — `cargo clippy --workspace --all-targets -- -D warnings`
#      when any `.rs` file is staged. R308 D9 closure (warnings → deny
#      baseline): any new clippy warning trips the gate. Workspace-level
#      allow list in root Cargo.toml covers `doc_lazy_continuation` (rustdoc
#      renders both forms) and `inconsistent_digit_grouping` (YYYY_MM_DD
#      date u64 literals). Per-site `#[allow]` for API-shape exemptions
#      (`result_large_err` on tonic interceptors; `too_many_arguments` on
#      the `scan_paths_no_resolvers` test helper).
#
#   5a. Item-citation gate (R1077/R1078) — `tools/item-citations` when any
#      `.rs` is staged: every `[`name`]` in this workspace's code names an
#      item rustdoc can resolve, over every target `cargo metadata` lists
#      rather than the 25 of 136 `cargo doc --workspace` reaches.
#
#   5c. Blind-wait gate (R1081) — `tools/blind-waits` when any `.rs` is
#      staged: in test code a wait ends on a CONDITION and the budget that
#      bounds it is NAMED. R1073's red main was `conflicts > 0` after 500ms
#      of eight writers — an assertion about the scheduler dressed as one
#      about the store — and the root workspace held four more of the shape,
#      including one whose too-short sleep PASSED an assertion of absence.
#      Parses with `syn`: no pattern can tell a synchronising `sleep` from
#      the retry step of a poll, and that difference is the whole law.
#
#   5b. Separate-workspace gate (R517) — fmt + clippy on the in-repo
#      crates that carry their OWN `[workspace]` (tools/experiment-harness,
#      bench/, studio/), which Gates 4/5 above never reach (`--all` /
#      `--workspace` only see root members). Structural, not hardcoded: for
#      each staged `.rs`, walk up to its owning `[workspace]` root and gate
#      any non-root one on its own `--manifest-path`, so a new `tools/<crate>`
#      is covered automatically. Runs ONLY when such a file is staged (the
#      root gate stays fast — the build-speed reason those crates are split
#      out). pre-push stays root-only by design: it validates the publishable
#      production workspace, while THIS gate keeps all committed Rust clean.
#      Closes the silent-fail where harness code committed unformatted because
#      no gate compiled it.
#
# Install (one-time per clone):
#   git config core.hooksPath .githooks
#
# Gated by `crates/mnemosyne-cli/tests/git_hooks_smoke.rs` (R899): every
# gate below has an accept/reject pair run against a throwaway repo wired
# to THIS file, so deleting a block turns a test red instead of going
# unnoticed. Add a case with any gate you add.
#
# Bypass: `--no-verify` (discouraged; the project policy treats audit
# gates as load-bearing, not nudges).

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

ATOMIC_SIDECAR="docs/.atomic/workspace.atomic.json"

# Round 823 — ONE resolver, `scripts/mn`, shared with pre-push and with
# interactive use. This hook used to prefer `target/release/mnemosyne-cli` if it
# existed and fall back to the PATH entry, and both could hand back the wrong
# tool: the release artifact was taken WITHOUT a freshness check, so an older
# build could gate a commit, and `~/.cargo/bin` is a slot shared with every other
# checkout on the machine. `scripts/mn` asks cargo instead, which is cheap now
# that the build script stops rerunning on every build.
cli=(scripts/mn)

staged=$(git diff --cached --name-only --diff-filter=ACMR || true)

# Gate 2 — code citation defense (R257+). Internally skips when
# [plugins.set_equality_validator] is unconfigured.
echo "[mnemosyne pre-commit] code citation defense — validate-code-refs" >&2
if ! "${cli[@]}" validate-code-refs; then
    {
        echo "[mnemosyne pre-commit] commit rejected — code citation violations"
        echo "  fix: verify each cited entry_id / §<id> / inventory id exists,"
        echo "       or register stale citations in mnemosyne.toml [[orphan_ledger]]"
    } >&2
    exit 1
fi

# Gate 3 — workspace validate when the atomic sidecar (the SSOT) is staged.
if printf '%s\n' "$staged" | grep -qx -- "$ATOMIC_SIDECAR"; then
    echo "[mnemosyne pre-commit] atomic sidecar staged — validate-workspace" >&2
    "${cli[@]}" validate-workspace
fi

# Gate 4 — rustfmt on .rs changes. Enforces the 4-space repo-wide baseline
# (rustfmt.toml); rejects unformatted code so the layout stays uniform.
if printf '%s\n' "$staged" | grep -qE '\.rs$'; then
    echo "[mnemosyne pre-commit] .rs staged — cargo fmt --all --check" >&2
    if ! cargo fmt --all --check; then
        {
            echo "[mnemosyne pre-commit] commit rejected — unformatted code"
            echo "  fix: cargo fmt --all && git add -u"
        } >&2
        exit 1
    fi
fi

# Gate 5 — clippy on .rs changes. R308 D9 closure: `-D warnings` lifts
# every warning to deny. Workspace allow list (root Cargo.toml) carries
# stylistic exemptions; per-site `#[allow]` for API-shape exemptions.
if printf '%s\n' "$staged" | grep -qE '\.rs$'; then
    echo "[mnemosyne pre-commit] .rs staged — cargo clippy --workspace --locked --all-targets -- -D warnings" >&2
    cargo clippy --workspace --locked --all-targets -- -D warnings
fi

# Gate 5a — item citations, the sibling `validate-code-refs` never had. That
# gate rejects a `Round NNN` in code that names no ledger entry; nothing rejected
# a `[`foo`]` that names no ITEM, and rustdoc — the resolver the toolchain
# already ships — had never been pointed at this workspace. R1077 pointed it and
# 34 links resolved to nothing, two of them advertising `mnemosyne-query`'s entry
# points by names the crate no longer had.
#
# ONE DEFINITION, in `tools/item-citations`, which is what CI runs. R1077's form
# here was `cargo doc --workspace`: it documents 25 of this workspace's 136
# targets, so a citation inside any of the 106 test targets — or inside a binary
# whose name collides with its package's library — passed it untouched. Both
# holes had a live citation in them when R1078 measured.
#
# The gate is resolved from THIS HOOK's location and pointed at the WORKING
# DIRECTORY, which are two different trees whenever this repository's hook runs
# over another one — its own smoke test does exactly that, and it is what caught
# the first version of this gate, which named the manifest relative to the cwd
# and so did not exist wherever it was actually invoked. R1069 made the same
# correction for the separate-workspace gate below; a gate that silently
# vanishes when its program is not under the caller's cwd is a gate that stops
# existing without saying so.
if printf '%s\n' "$staged" | grep -qE '\.rs$'; then
    echo "[mnemosyne pre-commit] .rs staged — item citations name items" >&2
    # THE VARIABLE HOLDS THE CHECKOUT, NOT THE MANIFEST. R1115: the gate that
    # asks whether every cargo command in this repository pins its lockfile has
    # to know WHICH lockfile each one resolves, and `--manifest-path "$gate"`
    # names nothing it can read — `"$gates/tools/item-citations/Cargo.toml"`
    # names one manifest whatever the prefix expands to. The tree this hook is
    # pointed at is still the working directory; only the program moves.
    gates="$(cd "$(dirname "$0")/.." && pwd)"
    if [[ ! -f "$gates/tools/item-citations/Cargo.toml" ]]; then
        echo "[mnemosyne pre-commit] commit rejected — the item-citation gate is" \
             "missing at $gates/tools/item-citations/Cargo.toml" >&2
        exit 1
    fi
    if ! cargo run -q --locked --manifest-path "$gates/tools/item-citations/Cargo.toml" \
        --bin item-citations -- --workspace "$(pwd)/Cargo.toml"; then
        {
            echo "[mnemosyne pre-commit] commit rejected — a citation names no item"
            echo "  run: cargo run -q --manifest-path tools/item-citations/Cargo.toml \\"
            echo "         --bin item-citations -- --workspace Cargo.toml"
        } >&2
        exit 1
    fi
fi

# Gate 5c — in test code a wait ends on a condition and its budget is named.
#
# R1073 turned main red with `conflicts > 0` after running eight writers for
# 500ms: an assertion whose subject is how the scheduler interleaved, wearing
# the clothes of an assertion about the store. R1075 swept `bench` and found the
# same shape in a neighbouring crate under the same comment. NOBODY had asked
# the root workspace, which is the tree that runs on every push — and it held
# four waits that end on a clock, one of which (`zero_rate_sampling_drops_all_
# spans`) had no red side at all: it slept 300ms and then required that nothing
# had arrived, so a wait too SHORT passed it.
#
# The gate parses (`syn`) rather than searching for text, because the difference
# between a `sleep` that IS the synchronisation and a `sleep` that is the retry
# step of a poll is the entire law, and no pattern sees it. Measured at 9.5s
# warm on this workspace — cheaper than Gate 5a above.
#
# Resolved from THIS HOOK's location, pointed at the WORKING DIRECTORY, for the
# reason spelled out under Gate 5a.
if printf '%s\n' "$staged" | grep -qE '\.rs$'; then
    echo "[mnemosyne pre-commit] .rs staged — waits end on conditions" >&2
    # The checkout, not the manifest — see Gate 5b.
    gates="$(cd "$(dirname "$0")/.." && pwd)"
    if [[ ! -f "$gates/tools/blind-waits/Cargo.toml" ]]; then
        echo "[mnemosyne pre-commit] commit rejected — the blind-wait gate is" \
             "missing at $gates/tools/blind-waits/Cargo.toml" >&2
        exit 1
    fi
    # THE TWO NON-ZERO EXITS MEAN DIFFERENT THINGS and printing one message for
    # both is how a gate teaches people the wrong lesson: 1 is "these sites
    # break the law", 2 is "I could not read enough of this tree to have an
    # opinion". The second one already misreported once, when a workspace
    # holding no test code was an exit 2 and this line called it a wait on a
    # clock.
    # `|| waits_verdict=$?` rather than a bare call and `$?`: this file runs
    # under `set -e`, which kills it at the failing command before any exit-code
    # branch can read one. The first version of this block did exactly that, and
    # the hook's own smoke test caught it — the gate's message reached stderr
    # and the hook's did not.
    waits_verdict=0
    cargo run -q --locked --manifest-path "$gates/tools/blind-waits/Cargo.toml" \
        --bin blind-waits -- --workspace "$(pwd)/Cargo.toml" || waits_verdict=$?
    if [[ $waits_verdict -eq 1 ]]; then
        {
            echo "[mnemosyne pre-commit] commit rejected — a test waits on a clock"
            echo "  run: cargo run -q --manifest-path tools/blind-waits/Cargo.toml \\"
            echo "         --bin blind-waits -- --workspace Cargo.toml"
        } >&2
        exit 1
    elif [[ $waits_verdict -ne 0 ]]; then
        {
            echo "[mnemosyne pre-commit] commit rejected — the blind-wait gate could" \
                 "not read this tree (exit $waits_verdict); its own message is above"
        } >&2
        exit 1
    fi

    # Gate 5d — every environment a spawned program reads is one its test names
    # (R1182). Same three-code contract as the gate above, and here for the same
    # reason: R1181 turned `main` red with a fixture whose environment list had
    # gone stale, green on every developer's machine and red on the runner.
    echo "[mnemosyne pre-commit] .rs staged — a test names what it spawns" >&2
    if [[ ! -f "$gates/tools/named-environment/Cargo.toml" ]]; then
        echo "[mnemosyne pre-commit] commit rejected — the named-environment gate" \
             "is missing at $gates/tools/named-environment/Cargo.toml" >&2
        exit 1
    fi
    environment_verdict=0
    cargo run -q --locked --manifest-path "$gates/tools/named-environment/Cargo.toml" \
        --bin named-environment -- --workspace "$(pwd)/Cargo.toml" || environment_verdict=$?
    if [[ $environment_verdict -eq 1 ]]; then
        {
            echo "[mnemosyne pre-commit] commit rejected — a test leaves a variable" \
                 "its spawned program reads to the machine"
            echo "  run: cargo run -q --manifest-path tools/named-environment/Cargo.toml \\"
            echo "         --bin named-environment -- --workspace Cargo.toml"
        } >&2
        exit 1
    elif [[ $environment_verdict -ne 0 ]]; then
        {
            echo "[mnemosyne pre-commit] commit rejected — the named-environment gate" \
                 "could not read this tree (exit $environment_verdict); its own message is above"
        } >&2
        exit 1
    fi
fi

# Gate 5b — separate in-repo workspaces (own `[workspace]`; Gates 4/5 above,
# `--all`/`--workspace`, never reach them). Structural: for each staged `.rs`,
# walk up to its owning `[workspace]` root and gate any non-root one on its own
# manifest. Runs only when such a file is staged, so the root gate stays fast.
sub_ws=""
while IFS= read -r f; do
    [[ "$f" == *.rs ]] || continue
    d=$(dirname "$f")
    while [[ "$d" != "." && "$d" != "/" ]]; do
        if [[ -f "$d/Cargo.toml" ]] && grep -qE '^\[workspace\]' "$d/Cargo.toml"; then
            sub_ws+="$d"$'\n'
            break
        fi
        d=$(dirname "$d")
    done
done <<< "$staged"
if [[ -n "${sub_ws//[$'\n']/}" ]]; then
    while IFS= read -r ws; do
        [[ -n "$ws" ]] || continue
        echo "[mnemosyne pre-commit] .rs staged in separate workspace '$ws' — fmt --check + clippy -D warnings" >&2
        # ONE DEFINITION, in `scripts/check-side-workspaces.sh`: the same script
        # CI runs whole, asked here for the lint half only — which is exactly
        # what the root workspace gets before a commit (Gates 4 and 5 above run
        # fmt and clippy, never the suite). This hook carried its own copy of
        # those two commands until R1066, and the copy had a defect the CI one
        # did not: without `--all` a VIRTUAL manifest has no targets, so
        # `cargo fmt` printed its usage, exited non-zero, and this gate rejected
        # every commit touching `bench` as "unformatted" having checked nothing.
        # Resolved from THIS HOOK's location, not the working directory: the
        # hook may be run over another tree (its own smoke test does exactly
        # that), and a gate that silently vanishes when its script is not under
        # the caller's cwd is a gate that stops existing without saying so.
        gate="$(cd "$(dirname "$0")/.." && pwd)/scripts/check-side-workspaces.sh"
        if [[ ! -x "$gate" ]]; then
            echo "[mnemosyne pre-commit] commit rejected — the separate-workspace gate" \
                 "is missing at $gate" >&2
            exit 1
        fi
        if ! "$gate" --lint-only "$ws"; then
            {
                echo "[mnemosyne pre-commit] commit rejected — $ws does not pass its own gate"
                echo "  run: scripts/check-side-workspaces.sh $ws"
            } >&2
            exit 1
        fi
    done < <(printf '%s' "$sub_ws" | sort -u)
fi

# Gate 6 — vN version-postfix identifier ban (CLAUDE.md anti-pattern).
# Extending a definition must modify it in place; no `foo_v2` / `BarV3`
# version postfixes anywhere — production OR test fixtures/names/data.
# Scans ADDED lines in staged `.rs` files. `_v[0-9]` intentionally does
# not match `_version` (schema_version etc. are real version numbers).
if printf '%s\n' "$staged" | grep -qE '\.rs$'; then
    echo "[mnemosyne pre-commit] .rs staged — vN version-postfix ban" >&2
    vn_hits=$(git diff --cached --unified=0 --diff-filter=ACM -- '*.rs' \
        | grep -E '^\+' | grep -vE '^\+\+\+' \
        | grep -E '[A-Za-z0-9]_v[0-9]|[a-z0-9]V[0-9]' || true)
    if [[ -n "$vn_hits" ]]; then
        {
            echo "[mnemosyne pre-commit] commit rejected — vN version-postfix identifier"
            echo "  banned: foo_v2 / BarV3 version postfixes — extend the definition in place."
            echo "  offending added lines:"
            printf '%s\n' "$vn_hits" | sed 's/^/    /'
        } >&2
        exit 1
    fi
fi
