#!/usr/bin/env bash
# pre-push hook — re-run integrity + lint gates before publishing
# commits to a remote.
#
# Push is the natural integrity-gate point: this is where the project's
# audit-traced state becomes shared. Catches state changes since last
# commit (manual atomic.json edits, amends, rebases, `--no-verify`
# bypasses) that pre-commit may have missed.
#
# Exception: delete-only pushes (branch/tag deletions) publish no commits,
# so there is nothing to validate — they skip all gates (see delete_only
# below). Drift on the working state is caught on the next commit push.
#
# Checks:
#
#   1. `mnemosyne-cli validate-workspace` (store-direct, the SSOT)
#      - T1 prose cross-ref orphan delta
#      - T2 frozen-ledger violations
#      - T3/T4 style violations
#      - Atomic ledger consistency (entries / sections / orphan refs)
#      - Publishable / audit divergence ↔ override ledger match (R296)
#      - Commit ↔ ledger drift (cited vs entries scan)
#
#   2. `cargo fmt --all --check`
#      - rustfmt 4-space repo-wide baseline (rustfmt.toml, edition 2021).
#
#   3. CI state of `origin/main` (R890, R893) — REPORT ONLY, never blocks.
#      - Nothing here could see a red CI; four consecutive red runs went
#        unnoticed for eleven hours. See the block at the bottom for why
#        this reports rather than gates, and what it cannot see.
#      - Conclusion AND annotations. A green run still says things, and
#        this repo shipped a deprecated action runtime for months because
#        `success` was the whole of what anything here read.
#      - THE READING IS `tools/ci-state` (R1136), not this file. Three
#        `gh -q '<expression>'` calls stood here, and the suite that holds
#        this hook up stubs `gh` with already-filtered lines, so nothing
#        could ask whether they still named fields GitHub still sends.
#
#   4. `tools/one-machine --read` — what a machine that is not this one found
#      in this tree (R1234). REPORT ONLY, on gate 3's argument. `pre-commit`
#      dispatched the census when the round's bytes stopped moving; this reads
#      the answer. The census is a claim about a MACHINE and has been wrong
#      four times, every one found where its author was not sitting.
#
# WHAT THIS HOOK NO LONGER DOES, AND WHERE IT WENT (R1287, R1288). Three gates
# that COMPILE the tree stood between 2 and 4 above, and every one of them is now
# a hosted job's:
#
#   - `cargo clippy --workspace --all-targets -- -D warnings` → a step in the
#     `validate` job (R1287). It had run HERE and on no runner at all, which
#     nothing could tell by reading either file until a census asked.
#   - `scripts/check-side-workspaces.sh --ours-only`, WHOLE → the
#     `side-workspaces` job (R1288), which invokes the same script.
#   - `tools/unrun-tests --ours-only` → the `unrun-tests` job (R1288).
#
# THE OWNER ASKED FOR THIS THREE TIMES and the last time named the reason: the
# verification was too slow to sit through. Measured on the push interrupted to
# make the change, the side gate alone had spent 817 seconds and was 2 workspaces
# of 24 into its citations phase; the hosted job does the whole thing in 19m00s,
# beside nine other jobs, on a machine that is not also building three sibling
# repositories.
#
# THE RESIDUE, STATED RATHER THAN DISCOVERED. Each of those three gates was put
# where it was BECAUSE a red had reached `origin/main` — R1151/R1152 for the side
# workspaces, R1193 for a doc-test nothing ran. Those reds can reach `main` again
# and be read one round later, which is the trade `RULEBOOK.md` states for the
# whole population. What keeps the move from being a deletion is
# `git_hooks_smoke::every_gate_a_hook_stopped_running_is_one_the_hosted_workflow_runs`,
# which asks the workflow to declare work for each and asks BOTH hooks not to be
# running them.
#
# Install (one-time per clone):
#   git config core.hooksPath .githooks
#
# Gated by `crates/mnemosyne-cli/tests/git_hooks_smoke.rs` (R899): the
# delete-only skip, the workspace gate's exit code, and — since R1136 —
# that this hook CALLS the CI reporter with the commit it means and passes
# its words through, whatever they are. What GitHub answers and what that
# answer means are gated where they are read, in `tools/ci-state/tests/`,
# against recorded real bodies and with the reporter run as a process.
# Add a case here with any branch you add HERE.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Skip the gates for delete-only pushes. Git feeds one line per ref update on
# stdin ("<local_ref> <local_sha> <remote_ref> <remote_sha>"); a deletion has
# an all-zero <local_sha> and publishes no commits, so there is nothing to
# validate. If every ref update is a deletion, exit clean. (An empty stdin —
# no ref updates — is likewise nothing to publish.)
delete_only=1
# The ranges this push would publish, one per non-delete ref. Collected in the
# SAME loop that decides `delete_only` so the two cannot disagree about what is
# being pushed -- the identity gate below is keyed on them.
ident_ranges=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ -z "${local_sha:-}" ]] && continue
    if [[ ! "$local_sha" =~ ^0+$ ]]; then
        delete_only=0
        if [[ "${remote_sha:-}" =~ ^0*$ ]]; then
            # New ref on the remote: grade the WHOLE history. Deliberate, not
            # incidental -- a brand-new remote is exactly when a stray identity
            # would be republished wholesale.
            ident_ranges+=("$local_sha")
        else
            ident_ranges+=("$remote_sha..$local_sha")
        fi
    fi
done
if [[ "$delete_only" -eq 1 ]]; then
    echo "pre-push: delete-only push (no commits to validate) — skipping gates" >&2
    exit 0
fi

# Gate 0 — the identities this push would publish.
#
# FIRST, because it is the one refusal here that a revert does not undo: the
# remote is public and a push does not un-publish. pre-commit carries the same
# list, and it would not have caught the incident lib/ident-gate.sh describes:
# those commits were made where the hooks were not installed, so the push is
# the first moment this repository could see them and the last before they are
# published.
# From THIS HOOK's directory, not `repo_root` — see the note in `pre-commit`
# for the fixture case that told the two apart.
# shellcheck source=.githooks/lib/ident-gate.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/ident-gate.sh"
ident_push_failed=0
for ident_range in "${ident_ranges[@]}"; do
    ident_gate_range "pre-push" "$ident_range" || ident_push_failed=1
done
if [[ "$ident_push_failed" -ne 0 ]]; then
    echo "pre-push: rewrite the offending commits before pushing — the remote" >&2
    echo "  is public and a push does not un-publish" >&2
    exit 1
fi

# Round 823 — ONE resolver, `scripts/mn`, the same one pre-commit uses. See that
# hook for why the release-then-PATH chain that stood here was two ways to get
# the wrong tool.
cli=(scripts/mn)

echo "pre-push: ${cli[*]} validate-workspace ..." >&2
if ! "${cli[@]}" validate-workspace; then
    echo "pre-push: validate-workspace failed — fix violations before push" >&2
    exit 1
fi

# OVER THE WORKSPACES THE PUSHED RANGE'S OWN `.rs` LIVE IN (R1293).
#
# `cargo fmt --all` formats the members of the manifest it RESOLVES, and the root
# workspace has twenty-six of them — none of which is a crate under `tools/`,
# `bench/` or `studio/`, because those carry their own `[workspace]` so the
# root's commands never reach them. This line therefore said nothing about a
# push whose changes were all in a side workspace, and neither did the commit
# hook's copy; `scripts/check-side-workspaces.sh` is the only thing that ever
# checked them, and R1288 moved it to CI.
#
# A RANGE RATHER THAN A STAGED LIST, which is the same question this hook's
# subject asks: `pre-commit` grades what is about to be committed, this grades
# what is about to be published. Both go through
# `.githooks/lib/rs-workspaces.sh`, because two spellings of "which workspace
# owns this file" is a pair that can disagree in silence — and R1288 measured
# what reading ONE hook costs: the most expensive gate in the repository left
# the other one, and a law that read only the first would have called the move
# complete.
#
# AND A RANGE THIS HOOK CANNOT READ IS NOT AN EMPTY ONE. The paths decide which
# trees are graded, so a `git diff` that failed would silently narrow this gate
# to nothing — the shape `pre-commit`'s staged-list read refuses one hook over.
echo "pre-push: cargo fmt --all --check ..." >&2
# shellcheck source=.githooks/lib/rs-workspaces.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/rs-workspaces.sh"
pushed_rs=""
for ident_range in "${ident_ranges[@]}"; do
    # NO `-- '*.rs'` PATHSPEC ON EITHER, and that is measured rather than tidy:
    # `git ls-tree -r --name-only HEAD -- '*.rs'` returns ZERO lines in this
    # repository, because ls-tree's pathspec is not the glob `git diff`'s is.
    # Two commands with two matching rules is one of them being silently empty,
    # and an empty answer here reads exactly like a push with no Rust in it. The
    # `.rs` filter lives in `rs_workspaces_of`, once, for both.
    if [[ "$ident_range" == *..* ]]; then
        range_read=(git diff --name-only --diff-filter=ACMR "$ident_range")
    else
        # A NEW REF ON THE REMOTE PUBLISHES THE WHOLE TREE AT THAT COMMIT, which
        # is exactly the decision gate 0 makes one screen up about identities —
        # `ident_ranges` carries a bare sha for that case and grades all of it.
        # Diffing a bare sha would compare it to the WORKING TREE instead, which
        # on a clean checkout is empty: a gate that answers "no Rust here" about
        # a push carrying the entire repository.
        range_read=(git ls-tree -r --name-only "$ident_range")
    fi
    if ! range_rs=$("${range_read[@]}"); then
        echo "pre-push: the files in $ident_range could not be read, and an unreadable" >&2
        echo "  range is not an empty one — it would narrow this gate to nothing" >&2
        exit 1
    fi
    pushed_rs="$pushed_rs$range_rs"$'\n'
done
if ! rs_workspaces_of "pre-push: refused" "$(pwd)" "$pushed_rs"; then
    exit 1
fi
# A PUSH WITH NO RUST IN IT GRADES NO WORKSPACE, said out loud rather than left
# as an empty loop that reads exactly like a clean run.
if [[ ${#RS_WORKSPACES[@]} -eq 0 ]]; then
    echo "pre-push: no .rs in the pushed range — no workspace to format-check" >&2
else
    echo "pre-push: the pushed .rs live in ${#RS_WORKSPACES[@]} workspace(s):" \
         "${RS_WORKSPACES[*]}" >&2
    for fmt_manifest in "${RS_WORKSPACES[@]}"; do
        if ! cargo fmt --all --check --manifest-path "$fmt_manifest"; then
            echo "pre-push: unformatted code in $fmt_manifest — run scripts/fmt.sh" >&2
            exit 1
        fi
    done
fi

# WHERE THE WORKSPACE CLIPPY GATE WENT (R1287), and why nothing stands here.
#
# `cargo clippy --workspace --locked --all-targets` ran on this line and on no
# hosted runner, which nobody could tell by reading either file — the census that
# says so is `git_hooks_smoke::every_compiling_gate_a_git_hook_runs_is_one_a_hosted_job_runs`,
# and its FIRST form got it wrong in the reassuring direction: keyed by
# subcommand and manifest, this gate and `server-features`' one-package clippy
# both resolve to the root and read as covered. They are two gates. The key
# carries the scope now.
#
# THE OWNER'S WORD IS WHY IT MOVED RATHER THAN GAINING A TWIN. Twice in one
# session: move the heavy things to CI, verification here is too slow. This was
# the heaviest thing a push paid for, `validate` had 62 minutes of unused budget
# on the last green run, and a step there meets a warm cargo home.
#
# WHAT IT COSTS, WRITTEN RATHER THAN DISCOVERED: a lint-dirty commit now reaches
# `origin/main` and is read one round later, which is the trade `RULEBOOK.md`
# states for the whole population. `cargo fmt --all --check` above STAYS — it
# parses instead of compiling, so it is a second, not a venue question.
#
# AND THE BUILD-MACHINE WRAPPER LEFT WITH IT. This was the only `$BX` in any
# hook, so R1285's distinction — a wrapper that could not PLACE a gate is not a
# gate that found something — has no subject in this file any more, and its law
# and fixture went with the block rather than being kept as scenery for a branch
# that cannot run. The distinction itself is not retired: N232 is the count of
# every OTHER place in this repository that reads a wrapper's exit as the wrapped
# command's verdict, and that census is where it lives next.

# ONE SPELLING OF "THE CHECKOUT THIS HOOK CAME FROM", used by every gate below
# that runs a program of this repository's over whatever tree it was invoked in.
# This file once held two spellings of it, the second reaching for `dirname`
# where this one is a BUILTIN — the difference the CI reporter below records
# having been bitten by, on the deliberately hermetic PATH its own smoke case
# runs this hook under.
hook_checkout="$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)"

# WHERE GATES 4 AND 5 WENT (R1288), and this is the owner's instruction carried
# the whole way rather than to the edge of what one census could see.
#
# Gate 4 ran `scripts/check-side-workspaces.sh --ours-only` WHOLE — fmt, clippy,
# citations, waits and the suites, over every workspace this repository owns.
# Gate 5 ran `tools/unrun-tests --ours-only`, which builds every test target the
# lister offers and asks each binary what it holds.
#
# BOTH ARE RUN BY A HOSTED JOB ALREADY: `side-workspaces` invokes the same script
# and `unrun-tests` has a job of its own, which is why R1287's census listed the
# second among the eight gates paid in both places. The first it could NOT list,
# and the reason is worth keeping: `check-side-workspaces.sh` is dropped from
# `ci_plan`'s shell source on purpose — the workspace lister reports the same
# commands assembled, so reading the text as well would ask twice about words
# that are `"${locked[@]}"` on the page — and the cost therefore lands on the
# lister rather than on the hook that invokes it. A gate can be invisible to the
# instrument that is supposed to find it, and this one was.
#
# WHAT IT COST, MEASURED ON THE PUSH THAT WAS INTERRUPTED TO WRITE THIS: gate 4
# had spent 817 seconds and was 2 workspaces into the citations phase of 24. The
# hosted `side-workspaces` job does the whole thing in 19m00s, in parallel with
# nine other jobs, on a machine that is not also building three sibling
# repositories. The local copy is the expensive one and it is the same work.
#
# WHAT IS GIVEN UP, STATED RATHER THAN DISCOVERED. R1156 put gate 4 here BECAUSE
# a red reached `origin/main`: editing root source can rot a side workspace's
# test, and nothing before a push touched it. That red can now reach `main`
# again, one round earlier than it is read. It is the trade `RULEBOOK.md` states
# for the whole population and the owner has now asked for three times — and it
# is a real cost, not a technicality. The same goes for gate 5's own case: R1193
# published a doc-test nothing runs, and the first reader was a hosted job.
#
# `studio` KEEPS WHAT IT HAD AND NO LESS: gate 4 ran `--ours-only`, so it was
# already skipping the workspace that path-depends on a sibling checkout. What
# still reads `studio` is the pre-commit gate when a side `.rs` is staged, and
# the whole-gate run the round checklist asks for.

# 6. Report what CI said about the commit this push builds on (R890).
#
# Nothing in this repo could see a red CI. `mnemosyne-validate` failed on four
# consecutive pushes over eleven hours (R872, R874, R877, R883) and was found by
# a human typing `gh run list`; the cause was a missing `protoc` on the runner,
# which the local hooks cannot see because this machine has one. Worse, that
# failure killed the build before any test ran, hiding a second defect: the job
# checked out a shallow clone, so the evidence gates had never executed on CI at
# all (R888, R889). Two rounds went to failures a glance would have caught.
#
# REPORTS, never blocks — and that is the semantics the history argues for, not
# a softening. The R888 and R889 pushes were both made deliberately while CI was
# red, to fix it; a gate would have been wrong both times. What was missing was
# knowledge, not restraint.
#
# It reads the state of `origin/main` as this clone last saw it: the commit that
# is already published, which is what a new push builds on top of. Its limit is
# stated rather than papered over — a run that goes red after the LAST push of a
# session is seen at the NEXT session's first push, so the round checklist in
# `RULEBOOK.md` still owns reading the result of the push you just made.
#
# Every branch prints. A check that stays quiet when it cannot answer is
# indistinguishable from one that answered "fine".
#
# WHAT THIS FILE STILL DECIDES: which commit to report on, and that a reporter
# it cannot run is said out loud rather than skipped. What GitHub answered and
# what that answer means are READ, in Rust, by `tools/ci-state` — because the
# three `gh -q` expressions that used to stand here were the one part of this
# hook nothing could execute in a test. Measured twice before they were moved,
# each time by breaking one and running the suite that holds this hook up:
# `.conclusion` renamed to `.verdict` left it at 14 passed / 0 failed while a
# real `gh` would print every conclusion as `-`, so a RED commit reports clean;
# `annotations_count` renamed to `annotation_count` left it at 14 passed / 0
# failed while every commit reports no annotations at all, which is the exact
# blindness R893 added the second call to end.
base="$(git rev-parse --verify --quiet origin/main || true)"
if [[ -z "$base" ]]; then
    echo "pre-push: NOTE no local origin/main ref — cannot report CI state" >&2
else
    # THE PROGRAM COMES FROM THIS HOOK'S CHECKOUT; the TREE it reports on is the
    # working directory. Those are two different trees whenever this repository's
    # hooks run over another one — which is exactly what their smoke test does —
    # and resolving from `$repo_root` would look for the reporter inside the tree
    # under check, where it does not exist. `scripts/check-side-workspaces.sh`
    # resolves its two gates the same way, for the same reason.
    #
    # NO `-f` GUARD IN FRONT OF IT, and that is a decision: a reporter that is not
    # there makes `cargo run` fail, which is the branch below, and it prints the
    # true sentence. A separate guard would be a branch nothing in this hook's
    # suite could reach — the reporter is resolved from THIS checkout, where it
    # always exists — and a branch with no reader is the shape R1127 to R1129
    # measured three times over.
    # THE MANIFEST IS SPELLED OUT IN THE COMMAND, not hidden behind the variable,
    # and that is a requirement rather than a preference. `locked_resolution_smoke`
    # reads every cargo command this repository issues and asks which workspace's
    # lockfile each one resolves; the neighbouring script's commands are read off
    # the lister's own expanded output, but a hook is read STATICALLY, so a bare
    # `"$reporter"` names nothing and the gate answers `Unreadable` — which it
    # counts as a failure, because a gate that cannot say which workspace a
    # command resolves cannot say whether that lockfile is pinned. It caught this
    # exact line in this round.
    # `$hook_checkout` IS RESOLVED ONCE, above (R1230). This line used to resolve
    # the same directory a second time, and with `dirname` — an external program
    # where the other spelling is a builtin, which is the difference the side
    # gate's comment above records having been bitten by.
    if ! cargo run -q --manifest-path "$hook_checkout/tools/ci-state/Cargo.toml" --locked --bin ci-state -- "$base" >&2; then
        # It exits 2 only when it could not produce a report AT ALL; every state
        # it can describe — gh absent, gh unreachable, an answer it cannot read,
        # a RED commit — it prints and exits 0 for. A check that stays quiet when
        # it cannot answer is indistinguishable from one that answered "fine".
        echo "pre-push: NOTE the CI reporter could not run — CI state for ${base:0:8} unknown" >&2
    fi
fi

# 7. What a machine that is not this one found in this tree (R1234).
#
# `tools/outside-reach` decides what this repository's suite reaches outside
# itself, and its answer is a claim about a MACHINE as much as about the source.
# This repository has caught it wrong four times and every one was found where
# its author was not sitting. `pre-commit` sends the census to a machine the
# placement program chose; this reads what that machine wrote, and the reading is
# a program because the states that matter are not two.
#
# THE THREE CODES ARE PRINTED AND NONE OF THEM BLOCKS, which is gate 6's
# semantics and gate 6's argument: R888 and R889 were both pushes made
# deliberately while CI was red, to fix it, and a gate would have been wrong both
# times. What is missing when a second machine has not answered is KNOWLEDGE, not
# restraint — and "not answered" is most of what the third code means here (no
# dispatch, a machine that is busy, a run still going, an answer about bytes that
# have since changed). Every one of those states reports zero findings under a
# two-code gate, which is why the program names them apart out loud.
echo "pre-push: tools/one-machine (what a machine that is not this one found here) ..." >&2
elsewhere_verdict=0
cargo run -q --locked --manifest-path "$hook_checkout/tools/one-machine/Cargo.toml" \
    --bin one-machine -- --repo "$repo_root" --read >&2 || elsewhere_verdict=$?
if [[ $elsewhere_verdict -eq 1 ]]; then
    echo "pre-push: NOTE a second machine found something in this tree — its report is" \
         "above. Nothing here blocks on it, for the reason gate 6 does not" >&2
elif [[ $elsewhere_verdict -ne 0 ]]; then
    echo "pre-push: NOTE no second machine has judged this tree (exit $elsewhere_verdict);" \
         "its own message is above. This push carries only this machine's opinion" >&2
fi

exit 0
