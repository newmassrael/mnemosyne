#!/usr/bin/env bash
# pre-push hook — re-run integrity + lint gates before publishing
# commits to a remote.
#
# Push is the natural integrity-gate point: this is where the project's
# audit-traced state becomes shared. Catches state changes since last
# commit (manual atomic.json edits, amends, rebases, `--no-verify`
# bypasses) that pre-commit may have missed.
#
# Exception: delete-only pushes (branch/tag deletions) publish no commits,
# so there is nothing to validate — they skip all gates (see delete_only
# below). Drift on the working state is caught on the next commit push.
#
# Checks:
#
#   1. `mnemosyne-cli validate-workspace` (store-direct, the SSOT)
#      - T1 prose cross-ref orphan delta
#      - T2 frozen-ledger violations
#      - T3/T4 style violations
#      - Atomic ledger consistency (entries / sections / orphan refs)
#      - Publishable / audit divergence ↔ override ledger match (R296)
#      - Commit ↔ ledger drift (cited vs entries scan)
#
#   2. `cargo fmt --all --check`
#      - rustfmt 4-space repo-wide baseline (rustfmt.toml, edition 2021).
#
#   3. `cargo clippy --workspace --all-targets -- -D warnings`
#      - R308 D9 closure: every warning lifts to deny. Workspace allow
#        list (root Cargo.toml) carries stylistic exemptions
#        (`doc_lazy_continuation`, `inconsistent_digit_grouping`);
#        per-site `#[allow]` for API-shape exemptions.
#      - Unconditional (push validates publishable state, so the clippy
#        budget is paid once per push regardless of which files changed).
#
#   4. `scripts/check-side-workspaces.sh` — every SEPARATE in-repo workspace,
#      WHOLE (fmt, clippy, citations, waits and its SUITE). R1156.
#      - `--workspace` above means the ROOT one. Until this round the side
#        workspaces' suites ran only on CI, and pre-commit reached them only
#        when a `.rs` inside one was STAGED, lint-half only. Editing ROOT
#        source can rot a side workspace's test — `sweeps.rs` anchors are
#        exact text naming root files — and that is how R1151/R1152 put a red
#        on `origin/main` behind five green root runs.
#
#   5. `tools/unrun-tests` — every test this commit publishes is one some CI
#      command runs (R1230). CI ran this and nothing here did, so a test
#      nothing executes reached `origin/main` and was found by the runner
#      (R1193, repaired by R1195). `--ours-only`, for the reason gate 4 has it.
#
#   6. CI state of `origin/main` (R890, R893) — REPORT ONLY, never blocks.
#      - Nothing here could see a red CI; four consecutive red runs went
#        unnoticed for eleven hours. See the block at the bottom for why
#        this reports rather than gates, and what it cannot see.
#      - Conclusion AND annotations. A green run still says things, and
#        this repo shipped a deprecated action runtime for months because
#        `success` was the whole of what anything here read.
#      - THE READING IS `tools/ci-state` (R1136), not this file. Three
#        `gh -q '<expression>'` calls stood here, and the suite that holds
#        this hook up stubs `gh` with already-filtered lines, so nothing
#        could ask whether they still named fields GitHub still sends.
#
#   7. `tools/one-machine --read` — what a machine that is not this one found
#      in this tree (R1234). REPORT ONLY, on gate 6's argument. `pre-commit`
#      dispatched the census when the round's bytes stopped moving; this reads
#      the answer. The census is a claim about a MACHINE and has been wrong
#      four times, every one found where its author was not sitting.
#
# Install (one-time per clone):
#   git config core.hooksPath .githooks
#
# Gated by `crates/mnemosyne-cli/tests/git_hooks_smoke.rs` (R899): the
# delete-only skip, the workspace gate's exit code, and — since R1136 —
# that this hook CALLS the CI reporter with the commit it means and passes
# its words through, whatever they are. What GitHub answers and what that
# answer means are gated where they are read, in `tools/ci-state/tests/`,
# against recorded real bodies and with the reporter run as a process.
# Add a case here with any branch you add HERE.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Skip the gates for delete-only pushes. Git feeds one line per ref update on
# stdin ("<local_ref> <local_sha> <remote_ref> <remote_sha>"); a deletion has
# an all-zero <local_sha> and publishes no commits, so there is nothing to
# validate. If every ref update is a deletion, exit clean. (An empty stdin —
# no ref updates — is likewise nothing to publish.)
delete_only=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [[ -z "${local_sha:-}" ]] && continue
    if [[ ! "$local_sha" =~ ^0+$ ]]; then
        delete_only=0
    fi
done
if [[ "$delete_only" -eq 1 ]]; then
    echo "pre-push: delete-only push (no commits to validate) — skipping gates" >&2
    exit 0
fi

# Round 823 — ONE resolver, `scripts/mn`, the same one pre-commit uses. See that
# hook for why the release-then-PATH chain that stood here was two ways to get
# the wrong tool.
cli=(scripts/mn)

echo "pre-push: ${cli[*]} validate-workspace ..." >&2
if ! "${cli[@]}" validate-workspace; then
    echo "pre-push: validate-workspace failed — fix violations before push" >&2
    exit 1
fi

echo "pre-push: cargo fmt --all --check ..." >&2
if ! cargo fmt --all --check; then
    echo "pre-push: unformatted code — run cargo fmt --all before push" >&2
    exit 1
fi

# ⚠ ROUTED THROUGH THE BUILD-MACHINE WRAPPER WHEN ONE IS CONFIGURED (`$BX`).
# Same reasoning as the pre-commit hook's Gate 5, and the same three rules:
# `$BX` is an opt-in whose absence is the old behaviour; nothing about a machine
# is named in this tree; and the wrapper's verdict is final — it already fails
# open on its own, so a refusal is a verdict rather than an outage and is never
# papered over by re-running the gate here.
#
# ⚠ `cargo fmt --all --check` above is deliberately NOT routed: it parses rather
# than compiles, so it costs a fraction of a transfer and would be slower away
# from home. What is worth moving is what actually compiles the workspace.
echo "pre-push: cargo clippy --workspace --locked --all-targets -- -D warnings ..." >&2
if [ -n "${BX:-}" ] && [ -x "${BX}" ]; then
    clippy_run=("${BX}" --label pre-push-clippy --
                cargo clippy --workspace --locked --all-targets -- -D warnings)
else
    clippy_run=(cargo clippy --workspace --locked --all-targets -- -D warnings)
fi
if ! "${clippy_run[@]}"; then
    echo "pre-push: clippy failed — fix violations before push" >&2
    exit 1
fi

# 4. The SEPARATE in-repo workspaces, WHOLE — fmt, clippy, citations, waits AND
#    their suites (Round 1156).
#
# The gates above say `--workspace`, and that word means the ROOT workspace. The
# others carry their own `[workspace]` precisely so the root gates never compile
# them, and until this round the only thing that ran their SUITES was CI. The
# pre-commit hook reaches them, but only when a `.rs` file INSIDE one is staged,
# and only for the lint half.
#
# THAT LEFT THE CROSS-WORKSPACE DIRECTION UNGUARDED, which is the one that broke.
# `tools/injection-harness/tests/sweeps.rs` asks whether every tracked injection
# still APPLIES — an anchor is exact text naming a file in the ROOT workspace —
# so editing root source can rot a side workspace's test while nothing that runs
# before a push touches it. Rounds 1151 and 1152 rewrote two of those files, five
# root-workspace runs stayed green, the pre-commit side gate never fired because
# no side `.rs` was staged, and the red arrived on `origin/main`.
#
# ONE DEFINITION, `scripts/check-side-workspaces.sh`, asked here for the WHOLE
# gate rather than `--lint-only`: this is the last point before the answer
# becomes shared, and the half that was missing is the suites. Resolved from THIS
# HOOK's checkout, for the reason the CI reporter below is — the hook may run
# over another tree, and a gate that vanishes when its script is not under the
# caller's cwd is a gate that stops existing without saying so.
# `${BASH_SOURCE[0]%/*}` rather than `dirname`: a BUILTIN, because this hook is
# also run on a deliberately hermetic PATH holding only `bash`, `git` and a cargo
# stub — and `dirname` is not on it. The case that found this is the CI
# reporter's, which proves the hook still works when almost nothing is reachable.
#
# ONE SPELLING OF "THE CHECKOUT THIS HOOK CAME FROM", used by every gate below
# that runs a program of this repository's over whatever tree it was invoked in.
# Three gates need it now and this file held two spellings of it, the second
# reaching for `dirname` where this one is a BUILTIN — the difference the block
# below records having been bitten by, on the deliberately hermetic PATH its own
# smoke case runs this hook under.
hook_checkout="$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)"
side_gate="$hook_checkout/scripts/check-side-workspaces.sh"
if [[ ! -x "$side_gate" ]]; then
    echo "pre-push: push rejected — the separate-workspace gate is missing at $side_gate" >&2
    exit 1
fi
# `--ours-only` SINCE ROUND 1225, and the flag is the whole of what this hook
# gives up. `studio` path-depends on the sibling `pinion` checkout, so running
# its gate here asks whether SOMEBODY ELSE'S working tree compiles at this
# instant. On 2026-08-16 the answer was no — a session in that repository was
# mid-edit — and three finished, locally-verified rounds could not be published
# for a reason nothing in this repository could fix. A hook that blocks on that
# is not answering the question it claims to.
#
# The flag names no workspace: the gate already decides ownership per workspace
# and prints it (`LOCK <ws> ours|foreign`), and this consumes that answer.
# The skipped ones are NAMED in the gate's closing line, so a green push never
# means "and something was quietly not looked at".
#
# WHAT IS GIVEN UP, so the next reader does not have to re-derive it: `studio`
# now has no unconditional automated reader. CI has no sibling checkout and
# skips it; what remains is the pre-commit gate when a side `.rs` is staged, and
# the whole-gate run the round checklist asks for. Round 784 repaired this crate
# precisely because no gate was watching it.
echo "pre-push: scripts/check-side-workspaces.sh (every workspace this repo owns, whole) ..." >&2
if ! "$side_gate" --ours-only; then
    echo "pre-push: a separate in-repo workspace does not pass its own gate" >&2
    echo "  run: scripts/check-side-workspaces.sh" >&2
    exit 1
fi

# 5. EVERY TEST THIS PUSH PUBLISHES IS ONE SOME CI COMMAND RUNS (Round 1230).
#
# This gate had run on CI and NOWHERE ELSE since it was written. What that cost
# is on the record: R1193 put a ```` ```ignore ```` fence in a doc comment, which
# makes a doc-test no command in this repository runs; every local gate was
# green, the push went out, and `origin/main` went red on the runner. R1195 paid
# it. The gate that found it is this one, and the first reader it had was a
# hosted job — the shape R890 recorded for CI state and R1156 for the separate
# workspaces, met a third time.
#
# WHY PUSH AND NOT COMMIT: measured on this workstation, warm, 88 seconds — it
# builds every test target of every workspace the lister offers and asks each
# binary what it holds. Gate 5a of `pre-commit` is seconds; this is not a
# per-commit price, and push is where the answer becomes shared anyway.
#
# `--ours-only`, FOR THE REASON GATE 4 HAS IT, and this gate needed it more: it
# BUILDS what the lister offers, so on the machine holding the sibling checkout
# its verdict depended on whether somebody else's working tree compiles at this
# instant. On 2026-08-17 it answered 2 — could not judge — for exactly that
# reason while everything in this repository was green. The flag names no
# workspace; the lister decides ownership and this consumes that answer, and
# what was left out is printed by name.
#
# THE THREE CODES, READ AS THREE (the shape `pre-commit` Gate 5a records): 0 is
# clean, 1 is "a test exists that nothing runs", 2 is "I could not read enough
# of this tree to have an opinion". A gate that could not judge is not a gate
# that passed, so both non-zero codes block — and they say which they were.
#
# `|| dark_verdict=$?` rather than a bare call: this file runs under `set -e`
# and would be killed at the failing command before any branch could read a code.
#
# NO `-f` GUARD IN FRONT OF IT, for the reason the CI reporter below states: the
# program is resolved from THIS checkout, where it always exists, so the guard is
# a branch nothing could reach — and a branch with no reader is the shape R1127
# to R1129 measured three times over. A gate that is not there makes `cargo run`
# fail, and that is the `-ne 0` arm, which prints the true sentence.
echo "pre-push: tools/unrun-tests (every test this publishes is one CI runs) ..." >&2
dark_verdict=0
cargo run -q --locked --manifest-path "$hook_checkout/tools/unrun-tests/Cargo.toml" \
    --bin unrun-tests -- --ours-only || dark_verdict=$?
if [[ $dark_verdict -eq 1 ]]; then
    {
        echo "pre-push: push rejected — this tree compiles a test no CI command runs"
        echo "  the gate named them above. Fix: run it from a job (a feature it"
        echo "  hides behind needs --all-features; an #[ignore] needs a command that"
        echo "  passes --ignored), or delete it."
    } >&2
    exit 1
elif [[ $dark_verdict -ne 0 ]]; then
    {
        echo "pre-push: push rejected — the unrun-tests gate could not judge this" \
             "tree (exit $dark_verdict); its own message is above"
    } >&2
    exit 1
fi

# 6. Report what CI said about the commit this push builds on (R890).
#
# Nothing in this repo could see a red CI. `mnemosyne-validate` failed on four
# consecutive pushes over eleven hours (R872, R874, R877, R883) and was found by
# a human typing `gh run list`; the cause was a missing `protoc` on the runner,
# which the local hooks cannot see because this machine has one. Worse, that
# failure killed the build before any test ran, hiding a second defect: the job
# checked out a shallow clone, so the evidence gates had never executed on CI at
# all (R888, R889). Two rounds went to failures a glance would have caught.
#
# REPORTS, never blocks — and that is the semantics the history argues for, not
# a softening. The R888 and R889 pushes were both made deliberately while CI was
# red, to fix it; a gate would have been wrong both times. What was missing was
# knowledge, not restraint.
#
# It reads the state of `origin/main` as this clone last saw it: the commit that
# is already published, which is what a new push builds on top of. Its limit is
# stated rather than papered over — a run that goes red after the LAST push of a
# session is seen at the NEXT session's first push, so the round checklist in
# `RULEBOOK.md` still owns reading the result of the push you just made.
#
# Every branch prints. A check that stays quiet when it cannot answer is
# indistinguishable from one that answered "fine".
#
# WHAT THIS FILE STILL DECIDES: which commit to report on, and that a reporter
# it cannot run is said out loud rather than skipped. What GitHub answered and
# what that answer means are READ, in Rust, by `tools/ci-state` — because the
# three `gh -q` expressions that used to stand here were the one part of this
# hook nothing could execute in a test. Measured twice before they were moved,
# each time by breaking one and running the suite that holds this hook up:
# `.conclusion` renamed to `.verdict` left it at 14 passed / 0 failed while a
# real `gh` would print every conclusion as `-`, so a RED commit reports clean;
# `annotations_count` renamed to `annotation_count` left it at 14 passed / 0
# failed while every commit reports no annotations at all, which is the exact
# blindness R893 added the second call to end.
base="$(git rev-parse --verify --quiet origin/main || true)"
if [[ -z "$base" ]]; then
    echo "pre-push: NOTE no local origin/main ref — cannot report CI state" >&2
else
    # THE PROGRAM COMES FROM THIS HOOK'S CHECKOUT; the TREE it reports on is the
    # working directory. Those are two different trees whenever this repository's
    # hooks run over another one — which is exactly what their smoke test does —
    # and resolving from `$repo_root` would look for the reporter inside the tree
    # under check, where it does not exist. `scripts/check-side-workspaces.sh`
    # resolves its two gates the same way, for the same reason.
    #
    # NO `-f` GUARD IN FRONT OF IT, and that is a decision: a reporter that is not
    # there makes `cargo run` fail, which is the branch below, and it prints the
    # true sentence. A separate guard would be a branch nothing in this hook's
    # suite could reach — the reporter is resolved from THIS checkout, where it
    # always exists — and a branch with no reader is the shape R1127 to R1129
    # measured three times over.
    # THE MANIFEST IS SPELLED OUT IN THE COMMAND, not hidden behind the variable,
    # and that is a requirement rather than a preference. `locked_resolution_smoke`
    # reads every cargo command this repository issues and asks which workspace's
    # lockfile each one resolves; the neighbouring script's commands are read off
    # the lister's own expanded output, but a hook is read STATICALLY, so a bare
    # `"$reporter"` names nothing and the gate answers `Unreadable` — which it
    # counts as a failure, because a gate that cannot say which workspace a
    # command resolves cannot say whether that lockfile is pinned. It caught this
    # exact line in this round.
    # `$hook_checkout` IS RESOLVED ONCE, above (R1230). This line used to resolve
    # the same directory a second time, and with `dirname` — an external program
    # where the other spelling is a builtin, which is the difference the side
    # gate's comment above records having been bitten by.
    if ! cargo run -q --manifest-path "$hook_checkout/tools/ci-state/Cargo.toml" --locked --bin ci-state -- "$base" >&2; then
        # It exits 2 only when it could not produce a report AT ALL; every state
        # it can describe — gh absent, gh unreachable, an answer it cannot read,
        # a RED commit — it prints and exits 0 for. A check that stays quiet when
        # it cannot answer is indistinguishable from one that answered "fine".
        echo "pre-push: NOTE the CI reporter could not run — CI state for ${base:0:8} unknown" >&2
    fi
fi

# 7. What a machine that is not this one found in this tree (R1234).
#
# `tools/outside-reach` decides what this repository's suite reaches outside
# itself, and its answer is a claim about a MACHINE as much as about the source.
# This repository has caught it wrong four times and every one was found where
# its author was not sitting. `pre-commit` sends the census to a machine the
# placement program chose; this reads what that machine wrote, and the reading is
# a program because the states that matter are not two.
#
# THE THREE CODES ARE PRINTED AND NONE OF THEM BLOCKS, which is gate 6's
# semantics and gate 6's argument: R888 and R889 were both pushes made
# deliberately while CI was red, to fix it, and a gate would have been wrong both
# times. What is missing when a second machine has not answered is KNOWLEDGE, not
# restraint — and "not answered" is most of what the third code means here (no
# dispatch, a machine that is busy, a run still going, an answer about bytes that
# have since changed). Every one of those states reports zero findings under a
# two-code gate, which is why the program names them apart out loud.
echo "pre-push: tools/one-machine (what a machine that is not this one found here) ..." >&2
elsewhere_verdict=0
cargo run -q --locked --manifest-path "$hook_checkout/tools/one-machine/Cargo.toml" \
    --bin one-machine -- --repo "$repo_root" --read >&2 || elsewhere_verdict=$?
if [[ $elsewhere_verdict -eq 1 ]]; then
    echo "pre-push: NOTE a second machine found something in this tree — its report is" \
         "above. Nothing here blocks on it, for the reason gate 6 does not" >&2
elif [[ $elsewhere_verdict -ne 0 ]]; then
    echo "pre-push: NOTE no second machine has judged this tree (exit $elsewhere_verdict);" \
         "its own message is above. This push carries only this machine's opinion" >&2
fi

exit 0
