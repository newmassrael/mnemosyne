#!/usr/bin/env bash
# A build-machine wrapper that REFUSES TO PLACE the work, the way `bx` refuses:
# a sentence on stderr and exit 2, which its `die` is the only source of.
#
# WHAT IT IS FOR. The wrapper's refusal and the wrapped command's failure are
# different answers, and a hook that reads `if ! wrapper …` prints the same
# sentence for both — telling whoever is pushing to fix lint violations in a tree
# whose lint has never run. Measured on the day the routing landed: a sibling
# checkout held the build machine and the real `bx` said so, in those words.
#
# IT NEVER RUNS THE COMMAND, which is the point: a stand-in that ran clippy would
# make the case pass for the wrong reason on a clean fixture.
#
# Reads nothing; writes nothing.
echo "bx: refusing to send this tree — another run of it is already alive" >&2
exit 2
